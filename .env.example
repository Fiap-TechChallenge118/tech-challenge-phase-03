# Copy to .env and fill in the values. Never commit the real .env.

# * Model artifact location
#   — ECS/produção: defina MODEL_BUCKET para baixar do S3 no startup.
#   — Local: deixe MODEL_BUCKET vazio; o loader usa MODEL_PATH.
MODEL_BUCKET=
MODEL_KEY=models/model.onnx

# * Caminho local do artefato (usado quando MODEL_BUCKET não está definido).
#   Padrão automático: models/model.onnx (USE_ONNX=true) ou models/model.pkl
MODEL_PATH=models/model.pkl

# * Inference runtime: "true" uses ONNX Runtime, "false" uses the sklearn .pkl
USE_ONNX=false

# * AWS
AWS_REGION=us-east-1

# * Logging
LOG_LEVEL=INFO
